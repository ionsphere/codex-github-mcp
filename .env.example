# ─── GitHub Authentication ────────────────────────────────────────────────────
# Your GitHub Personal Access Token (classic) or Fine-Grained PAT.
# Required scopes for full functionality:
#   repo, read:org, read:user, gist, notifications, workflow
#
GITHUB_TOKEN=ghp_your_token_here

# For GitHub Enterprise Server, override the API base URL:
# GITHUB_API_URL=https://github.your-company.com/api/v3

# ─── Transport ────────────────────────────────────────────────────────────────
# "stdio"  — default; used by Claude Desktop, Codex CLI, and standard harnesses
# "http"   — Streamable HTTP server for browser/network clients and self-hosting
MCP_TRANSPORT=stdio

# ─── HTTP Transport Options (only used when MCP_TRANSPORT=http) ───────────────
MCP_PORT=3000
MCP_HOST=127.0.0.1

# ─── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error  (default: info)
# Logs always go to stderr so they never corrupt the stdio MCP stream.
LOG_LEVEL=info
